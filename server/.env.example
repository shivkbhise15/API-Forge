# ── Server ────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB Atlas ─────────────────────────────────────────────
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://youruser:yourpassword@cluster0.xxxxx.mongodb.net/apiforge?retryWrites=true&w=majority

# ── JWT Secrets (min 32 chars, use: openssl rand -hex 32) ────
JWT_ACCESS_SECRET=replace_with_32_char_minimum_random_secret_string_here
JWT_REFRESH_SECRET=replace_with_different_32_char_minimum_random_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Email / SMTP (e.g. Brevo, Resend, Gmail, Mailgun) ─────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM="APIForge <noreply@apiforge.dev>"
EMAIL_VERIFY_TOKEN_EXPIRES_HOURS=24

# ── Redis (Upstash) ───────────────────────────────────────────
# Get from: https://console.upstash.com → Create Database → REST API
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# ── App URLs ──────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000

# ── Rate Limiting ─────────────────────────────────────────────
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=100
