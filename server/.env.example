# ══════════════════════════════════════════════════════
#  APIForge — Server Environment Variables
#  Copy this file to .env and fill in all values marked ★
# ══════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────
NODE_ENV=production          # development | staging | production
PORT=5000

# ── MongoDB Atlas ★ ───────────────────────────────────
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodbURLwithUsernameAndPasswordHere

# ── JWT Secrets ★ ─────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# MUST be at least 32 characters. Use DIFFERENT values for each.
JWT_ACCESS_SECRET=replace_with_64_char_random_hex_string_here_aaabbbcccddd
JWT_REFRESH_SECRET=replace_with_different_64_char_random_hex_string_here_xxx
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Email / SMTP ★ (required in production) ───────────
# Recommended: Resend (https://resend.com) or Brevo (https://brevo.com)
#
# Resend:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_USER=resend
#   SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxx
#
# Brevo (Sendinblue):
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=your@email.com
#   SMTP_PASS=your_brevo_smtp_key
#
# Gmail (for testing — not recommended for production):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your@gmail.com
#   SMTP_PASS=your_app_password   (Enable 2FA → App Passwords)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key_here
EMAIL_FROM=APIForge <noreply@yourdomain.com>
EMAIL_VERIFY_TOKEN_EXPIRES_HOURS=24

# ── Redis / Upstash ★ ─────────────────────────────────
# Get from: https://console.upstash.com → Create Database → REST API
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# ── App URLs ★ ────────────────────────────────────────
# In production: set CLIENT_URL to your deployed frontend URL
# If serving frontend from the same Express server, use your backend URL for both
CLIENT_URL=https://your-app.onrender.com
API_BASE_URL=https://your-app.onrender.com

# ── Rate Limiting ──────────────────────────────────────
GLOBAL_RATE_LIMIT_WINDOW_MS=900000   # 15 minutes in ms
GLOBAL_RATE_LIMIT_MAX=100            # max requests per window per IP
