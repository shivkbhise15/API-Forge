# ── Redis (Upstash) ★ ───────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://rested-anteater-80397.upstash.io
UPSTASH_REDIS_REST_TOKEN=gQAAAAAAAToNAAIgcDIwNGU4MjkwZTVjNzU0YWRlOTM3MjA0YzU2ODdlZDZiNA

# ── App URLs ─────────────────────────────────────────────────
# In production Express serves the built React SPA, so BOTH
# CLIENT_URL and API_BASE_URL point to the SAME origin (:5000).
# The browser's Origin header will be http://localhost:5000,
# which matches the CORS allowlist.
CLIENT_URL=http://localhost:5000
API_BASE_URL=http://localhost:5000

# ── Cookies ──────────────────────────────────────────────────
# Set to true only when running behind HTTPS (e.g. Render/Railway).
# Keep false for local production testing (HTTP on localhost).
HTTPS_ONLY=false

# ── Rate Limiting ────────────────────────────────────────────
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=200
