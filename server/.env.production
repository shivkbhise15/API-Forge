# ══════════════════════════════════════════════════════════
#  APIForge — PRODUCTION Environment
#  Used when NODE_ENV=production (npm run start:prod)
#
#  In production, Express serves the built React SPA from
#  client/dist on PORT 5000. There is NO separate Vite server.
#  Both CLIENT_URL and API_BASE_URL point to the same origin.
# ══════════════════════════════════════════════════════════

# ── Server ─────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── MongoDB Atlas ★ ─────────────────────────────────────────
MONGODB_URI=mongodb+srv://shivkdb:19892212@cluster0.shju66c.mongodb.net/apiforge

# ── JWT Secrets ★ ───────────────────────────────────────────
JWT_ACCESS_SECRET=109ea7c0-5515-48bb-827a-a3009f772114b8b731a5-aaa9-40a5-acc8-cd690926a982
JWT_REFRESH_SECRET=40950dbe-75bf-4412-87fa-317ceec1ac2c13d8ddb3-26f0-41d7-9862-d28140a869f9
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Email / SMTP ★ (required in production) ─────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=shivkbhise@gmail.com
SMTP_PASS=ujhw rgip dspk veim
EMAIL_FROM=APIForge <shivkbhise@gmail.com>
